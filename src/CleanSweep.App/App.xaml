<Application x:Class="CleanSweep.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:CleanSweep.App.Helpers"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             xmlns:v="clr-namespace:CleanSweep.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!-- 颜色 -->
            <SolidColorBrush x:Key="Brush.Accent" Color="#087F8C"/>
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#066773"/>
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4F3F2"/>
            <SolidColorBrush x:Key="Brush.Hover" Color="#EDF2F7"/>
            <SolidColorBrush x:Key="Brush.Sidebar" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Brush.Background" Color="#F2F5F9"/>
            <SolidColorBrush x:Key="Brush.Border" Color="#E1E7EF"/>
            <SolidColorBrush x:Key="Brush.Text" Color="#182C43"/>
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#596B80"/>
            <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
            <SolidColorBrush x:Key="Brush.Risk.Safe" Color="#0F7B0F"/>
            <SolidColorBrush x:Key="Brush.Risk.Confirm" Color="#B8860B"/>
            <SolidColorBrush x:Key="Brush.Risk.High" Color="#C42B1C"/>
            <SolidColorBrush x:Key="Brush.Risk.NotRecommended" Color="#7A7A7A"/>

            <!-- 转换器 -->
            <h:BytesConverter x:Key="Bytes"/>
            <h:RiskToBrushConverter x:Key="RiskBrush"/>
            <h:RiskToTextConverter x:Key="RiskText"/>
            <h:InverseBoolConverter x:Key="Not"/>
            <h:NullToVisibilityConverter x:Key="NullToVis"/>
            <h:CountToVisibilityConverter x:Key="CountToVis"/>
            <h:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <h:IntEqualsConverter x:Key="IntEquals"/>
            <h:AllTrueConverter x:Key="AllTrue"/>

            <!-- 文本 -->
            <Style x:Key="Page" TargetType="UserControl">
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="Background" Value="{StaticResource Brush.Background}"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="Text.Title" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Style>
            <Style x:Key="Text.Subtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="Text.Secondary" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- 按钮 -->
            <Style x:Key="Button.Base" TargetType="Button">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource Button.Base}"/>
            <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>

            <!-- 导航 -->
            <Style x:Key="Nav.Item" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="9" Padding="14,9" Margin="10,2" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" Margin="-8,0,10,0" Background="Transparent"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                    <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush.AccentHover}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 侧栏导航项模板（分组内与底部固定项共用） -->
            <DataTemplate x:Key="Nav.ItemTemplate">
                <RadioButton Style="{StaticResource Nav.Item}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             AutomationProperties.Name="{Binding Title}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DataTemplate>

            <!-- 侧栏分组标题：可折叠，左侧箭头随展开状态旋转 -->
            <Style x:Key="Nav.GroupHeader" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Margin="10,10,10,0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <DockPanel>
                                    <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 卡片 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="20"/>
            </Style>

            <!-- 保留原生输入、选择和滚动行为，统一密度与焦点反馈。 -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="8,7"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{StaticResource Brush.Sidebar}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,10"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                <Setter Property="MinRowHeight" Value="34"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource Brush.Sidebar}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,10"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            </Style>

            <Style x:Key="Settings.Tab" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Tab" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,8,12">
                                <ContentPresenter x:Name="Header" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{StaticResource Brush.TextSecondary}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource Brush.Hover}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                                    <Setter TargetName="Header" Property="TextElement.Foreground" Value="{StaticResource Brush.AccentHover}"/>
                                    <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Scroll.Thumb" TargetType="Thumb">
                <Setter Property="Background" Value="#B4C2D0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#8298AC"/></Trigger>
                                <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{StaticResource Brush.Accent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Scroll.Page" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="12"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                    <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource Scroll.Page}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource Scroll.Thumb}"/></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource Scroll.Page}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                    <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="12"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Progress.Solid" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <Grid x:Name="PART_Track" ClipToBounds="True">
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 风险标签 -->
            <Style x:Key="RiskBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 页面 → 视图映射 -->
            <DataTemplate DataType="{x:Type vm:QuickOptimizeViewModel}">
                <v:QuickOptimizePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanPageViewModel}">
                <v:CleanPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                <v:StartupPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SpaceAnalyzerViewModel}">
                <v:SpacePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
                <v:DuplicatesPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
                <v:QuarantinePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <v:SettingsPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UninstallViewModel}">
                <v:UninstallPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ShredViewModel}">
                <v:ShredPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                <v:DiskPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
                <v:MemoryPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OptimizeViewModel}">
                <v:OptimizePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriverViewModel}">
                <v:DriverPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PopupViewModel}">
                <v:PopupPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RepairViewModel}">
                <v:RepairPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
                <v:SystemInfoPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
                <v:HardwarePage/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
