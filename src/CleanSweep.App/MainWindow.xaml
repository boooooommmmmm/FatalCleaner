<Window x:Class="CleanSweep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="FatalCleaner · Windows 系统清理"
        Icon="/CleanSweep;component/Assets/FatalCleaner.ico"
        Width="1240" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,24,14,4">
                    <DockPanel>
                        <Border Width="34" Height="34" Background="White" Margin="0,0,10,0">
                            <Image x:Name="BrandIcon" Source="/CleanSweep;component/Assets/FatalCleaner.png"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="FatalCleaner 图标"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="BrandName" Text="FatalCleaner" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="让电脑轻装运行" Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding FeaturedItems}" ItemTemplate="{StaticResource Nav.ItemTemplate}" Margin="-10,22,-10,6"/>
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Elevation.StatusText}" Style="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding UpdateNotice}" ToolTip="{Binding UpdateNotice}" Foreground="{StaticResource Brush.Accent}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Height="32" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding UpdateNotice, Converter={StaticResource NullToVis}}"/>
                    <Button Content="以管理员身份重新启动" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0"
                            Command="{Binding RelaunchElevatedCommand}" IsEnabled="{Binding Home.CanEditScope}"
                            Visibility="{Binding Elevation.IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </StackPanel>

                <!-- 固定在底部、始终可见的项：隔离区（后悔药）与设置 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6" IsEnabled="{Binding Home.CanEditScope}">
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="16,4,16,6"/>
                    <ItemsControl ItemsSource="{Binding PinnedItems}" ItemTemplate="{StaticResource Nav.ItemTemplate}"/>
                </StackPanel>

                <!-- 分组的导航列表：组标题可折叠，列表自己滚动，顶部标题与底部区域固定 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" IsEnabled="{Binding Home.CanEditScope}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavGroup}">
                                <StackPanel>
                                    <ToggleButton Style="{StaticResource Nav.GroupHeader}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding AutomationName}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CollapsedHint}" Style="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </ToggleButton>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Nav.ItemTemplate}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <ContentControl Grid.Column="1" Content="{Binding Selected.Page}" MaxWidth="1440" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
