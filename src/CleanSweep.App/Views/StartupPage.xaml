<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartupViewModel}">
    <UserControl.Resources>
        <Style x:Key="Startup.StateBadge" TargetType="Border">
            <Setter Property="Background" Value="#087F67"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Background" Value="#52637A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuggestionText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.Suggestion}" Value="RecommendDisable">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Risk.Confirm}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.Suggestion}" Value="Keep">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Risk.Safe}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ImpactText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.Impact}" Value="High">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Risk.High}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.Impact}" Value="Medium">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Risk.Confirm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SignatureText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Item.Signature}" Value="Unsigned">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Risk.Confirm}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Item.Signature}" Value="Invalid">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Risk.High}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="开机加速" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="点击每行左侧“禁用”可关闭开机启动，之后可重新启用。服务需逐项确认改为手动启动；修改前自动备份。"
                       Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 开机时间 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="开机时间" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BootSummary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Boots}" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BootBar}">
                            <StackPanel Margin="3,0" ToolTip="{Binding ToolTip}" VerticalAlignment="Bottom">
                                <Rectangle Width="14" Height="{Binding BarHeight}" Fill="{StaticResource Brush.Accent}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"/>
                                <TextBlock Text="{Binding DateText}" FontSize="9" Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="2" Margin="0,14,0,10">
            <WrapPanel>
                <Button Content="刷新" Style="{StaticResource Button.Primary}" Command="{Binding RefreshCommand}" MinWidth="90"/>
                <Button Command="{Binding DisableRecommendedCommand}" Margin="8,0,0,0"
                        Visibility="{Binding RecommendCount, Converter={StaticResource CountToVis}}">
                    <TextBlock>
                        <Run Text="禁用全部“建议禁用”项（"/><Run Text="{Binding RecommendCount, Mode=OneWay}"/><Run Text="）"/>
                    </TextBlock>
                </Button>
                <CheckBox Content="显示微软项" IsChecked="{Binding ShowMicrosoft}" VerticalAlignment="Center" Margin="16,0,0,0"
                          ToolTip="显示微软自带的服务与计划任务（默认隐藏）"/>
            </WrapPanel>
            <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,6,0,0" ToolTip="颜色仅表示启动状态，不代表风险等级或禁用建议。">
                <Border Background="#087F67" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"/>
                <TextBlock Text="绿色：已启用 / 服务自动启动" FontSize="12" Margin="0,0,18,0" Foreground="#225F53"/>
                <Border Background="#52637A" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0"/>
                <TextBlock Text="灰色：已禁用 / 服务非自动" FontSize="12" Foreground="#52637A"/>
            </WrapPanel>
        </StackPanel>

        <!-- 列表 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListView ItemsSource="{Binding View}" BorderThickness="0" SelectionMode="Single" AutomationProperties.Name="启动项列表"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.Sidebar}" Padding="10,6" Margin="0,4,0,2">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" 项"/>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="#E4F4F0"/>
                            <Setter Property="BorderBrush" Value="#087F67"/>
                            <Setter Property="Foreground" Value="#183F36"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Border Width="4" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}"/>
                                            <GridViewRowPresenter Margin="8,6" Content="{TemplateBinding Content}"
                                                                  Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            <Border x:Name="SelectionOutline" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionOutline" Property="BorderBrush" Value="#9AAFC5"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionOutline" Property="BorderBrush" Value="#226BC2"/>
                                                <Setter TargetName="SelectionOutline" Property="BorderThickness" Value="2"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="SelectionOutline" Property="BorderBrush" Value="#226BC2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter Property="Background" Value="#EDF0F5"/>
                                    <Setter Property="BorderBrush" Value="#718096"/>
                                    <Setter Property="Foreground" Value="#52637A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="启用 / 禁用" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                                MinWidth="78" Padding="8,4" ToolTip="{Binding ToggleHint}"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding ToggleText}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="#FFF1DB"/>
                                                    <Setter Property="Foreground" Value="#85400F"/>
                                                    <Setter Property="BorderBrush" Value="#D8AC70"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Background" Value="#087F67"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="#087F67"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状态" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <Border Style="{StaticResource Startup.StateBadge}">
                                            <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="名称" Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Secondary}" FontSize="11"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="发布者" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Secondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="签名" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <TextBlock Text="{Binding SignatureText}" Style="{StaticResource SignatureText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="启动影响" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <TextBlock Text="{Binding ImpactText}" Style="{StaticResource ImpactText}" ToolTip="{Binding ImpactDetail}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="建议" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <TextBlock Text="{Binding SuggestionText}" Style="{StaticResource SuggestionText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="范围" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Text.Secondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="更多操作" Width="210">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开位置" Style="{StaticResource Button.Link}"
                                                    Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="延迟启动…" Style="{StaticResource Button.Link}"
                                                    Visibility="{Binding CanDelay, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DelayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="删除" Style="{StaticResource Button.Link}" Foreground="{StaticResource Brush.Danger}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="480"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                       Visibility="{Binding Rows.Count, Converter={StaticResource CountToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
