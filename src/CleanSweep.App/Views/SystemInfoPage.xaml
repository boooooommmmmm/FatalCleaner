<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="系统信息" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="系统、处理器、主板、内存、显卡、存储与网络的基本信息。全部只读。" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="复制" Command="{Binding CopyCommand}"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" MinWidth="90"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,18,0,0">
            <ListView ItemsSource="{Binding Items}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="类别" Width="90" DisplayMemberBinding="{Binding Group}"/>
                        <GridViewColumn Header="项目" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="值" Width="640">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" ToolTip="{Binding Value}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" BorderThickness="0" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}"/>
        </StackPanel>
    </Grid>
</UserControl>
