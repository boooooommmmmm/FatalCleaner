<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.DriverPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DriverViewModel}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="驱动与更新" Style="{StaticResource Text.Title}"/>
                <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"
                           Text="驱动存储区里同一硬件的多个版本：只删除没有设备在用的旧版本（pnputil /delete-driver，不带 /force）。删除前可先导出全部驱动备份。"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="导出全部驱动…" Command="{Binding ExportCommand}"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" MinWidth="90"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <CheckBox Content="只看旧版本" IsChecked="{Binding OnlyOld}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Summary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView ItemsSource="{Binding Drivers}" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="类别" Width="150" DisplayMemberBinding="{Binding Class}"/>
                        <GridViewColumn Header="提供程序" Width="150" DisplayMemberBinding="{Binding Provider}"/>
                        <GridViewColumn Header="原始 inf" Width="150" DisplayMemberBinding="{Binding Original}"/>
                        <GridViewColumn Header="发布名" Width="90" DisplayMemberBinding="{Binding Published}"/>
                        <GridViewColumn Header="版本" Width="200" DisplayMemberBinding="{Binding Version}"/>
                        <GridViewColumn Header="状态" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DriverRow}">
                                    <TextBlock Text="{Binding StateText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Risk.Confirm}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:DriverRow}">
                                    <Button Content="删除" Style="{StaticResource Button.Link}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.DeleteOldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Windows 更新" FontWeight="SemiBold" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="暂停" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PauseDays}" Width="40" Height="30" Margin="6,0" VerticalContentAlignment="Center" TextAlignment="Right"/>
                        <TextBlock Text="天" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="暂停更新" Command="{Binding PauseCommand}"/>
                        <Button Content="恢复更新" Style="{StaticResource Button.Link}" Command="{Binding ResumeCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding PauseText}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,6"/>
                <TextBlock Text="已安装的更新（卸载用 wusa /uninstall，只在某个更新确实引发问题时才卸载；更新缓存清理在“系统清理”中）" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                <ListView ItemsSource="{Binding Updates}" BorderThickness="0" MaxHeight="160" Margin="0,4,0,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="编号" Width="110" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="说明" Width="200" DisplayMemberBinding="{Binding Description}"/>
                            <GridViewColumn Header="安装日期" Width="100" DisplayMemberBinding="{Binding InstalledText}"/>
                            <GridViewColumn Header="" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:UpdateRow}">
                                        <Button Content="卸载" Style="{StaticResource Button.Link}"
                                                Command="{Binding DataContext.UninstallUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" BorderThickness="0" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" MaxHeight="120" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                     Visibility="{Binding Output, Converter={StaticResource NullToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
