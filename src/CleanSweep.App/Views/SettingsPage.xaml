<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="设置" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="管理清理偏好、恢复记录与程序更新" Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0"/>
        </StackPanel>
        <TabControl x:Name="SettingsSections" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource Settings.Tab}">
            <TabItem Header="常规与清理" AutomationProperties.Name="常规与清理">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- 常规 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="常规" FontWeight="SemiBold" FontSize="15"/>
                                <CheckBox IsChecked="{Binding AdvancedMode}" Margin="0,12,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="高级模式" FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="显示“不建议”级别的项目（如 Prefetch 预读取），这些项目清理后通常会让系统变慢。" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </TextBlock>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="隔离区保留天数" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding RetentionDays, UpdateSourceTrigger=LostFocus}" Width="60" Height="30" Margin="12,0,6,0" VerticalContentAlignment="Center" TextAlignment="Right" Padding="4,0"/>
                                    <TextBlock Text="天（1 到 365）。到期后自动永久删除。" VerticalAlignment="Center" Style="{StaticResource Text.Secondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- 残留清理与卸载监控 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="残留清理与卸载监控" FontWeight="SemiBold" FontSize="15"/>
                                <CheckBox IsChecked="{Binding WatchUninstalls}" Margin="0,12,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="卸载后即时残留提醒" FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="{Binding WatchStatus, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </TextBlock>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ResidueScanAllUsers}" IsEnabled="{Binding IsElevated}" Margin="0,12,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="残留清理扫描本机全部用户账户" FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="需要管理员权限。会额外检查其他账户的 AppData、ProgramData 以及已删除账户遗留的配置文件目录；其他账户的软件清单不可见，只按指纹库与活跃度判定。" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </TextBlock>
                                </CheckBox>

                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="开发者缓存：项目根目录" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,130,0"/>
                                    <Button Content="添加文件夹…" Command="{Binding AddDevRootCommand}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="在指定目录下查找闲置 node_modules，以及至少 24 小时未修改、有生成清单的 .NET bin/obj 文件（最多向下 6 层）。构建产物默认不勾选；请关闭 dotnet、MSBuild、Visual Studio、Rider 和运行中的项目后扫描。" Style="{StaticResource Text.Secondary}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding DevProjectRoots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="{Binding}" ToolTip="{Binding}" Margin="0,0,70,0" VerticalAlignment="Center"/>
                                                <Button Content="移除" Style="{StaticResource Button.Link}" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.RemoveDevRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="（尚未添加任何项目目录）" Style="{StaticResource Text.Secondary}"
                                    Visibility="{Binding DevProjectRoots.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="备份与白名单" AutomationProperties.Name="备份与白名单">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- 备份与还原 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button Content="打开备份目录" Command="{Binding OpenBackupDirCommand}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="备份与还原" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <CheckBox IsChecked="{Binding CreateRestorePoint}" Margin="0,12,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="修改服务启动类型前创建系统还原点" FontWeight="SemiBold"/>
                                        <LineBreak/>
                                        <Run Text="{Binding RestorePointStatus, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </TextBlock>
                                </CheckBox>

                                <TextBlock Text="注册表备份" FontWeight="SemiBold" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding BackupSummary}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                <ListView ItemsSource="{Binding RegistryBackups}" BorderThickness="0" MaxHeight="240"
                                    Visibility="{Binding RegistryBackups.Count, Converter={StaticResource CountToVis}}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding TimeText}"/>
                                            <GridViewColumn Header="注册表键" Width="360">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RegistryBackupRow}">
                                                        <TextBlock Text="{Binding KeyPath}" ToolTip="{Binding KeyPath}" Style="{StaticResource Text.Secondary}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="原因" Width="200" DisplayMemberBinding="{Binding Reason}"/>
                                            <GridViewColumn Header="状态" Width="150" DisplayMemberBinding="{Binding StateText}"/>
                                            <GridViewColumn Header="操作" Width="70">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RegistryBackupRow}">
                                                        <Button Content="还原" Style="{StaticResource Button.Link}"
                                                            Command="{Binding DataContext.RestoreRegistryBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <TextBlock Text="计划任务备份" FontWeight="SemiBold" Margin="0,16,0,0"
                                    Visibility="{Binding TaskBackups.Count, Converter={StaticResource CountToVis}}"/>
                                <TextBlock Text="注册表清理删除计划任务前保存的任务定义，可在此重新注册（任务已存在时不覆盖）。" Style="{StaticResource Text.Secondary}" Margin="0,4,0,8" TextWrapping="Wrap"
                                    Visibility="{Binding TaskBackups.Count, Converter={StaticResource CountToVis}}"/>
                                <ListView ItemsSource="{Binding TaskBackups}" BorderThickness="0" MaxHeight="200"
                                    Visibility="{Binding TaskBackups.Count, Converter={StaticResource CountToVis}}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="140" DisplayMemberBinding="{Binding TimeText}"/>
                                            <GridViewColumn Header="任务" Width="360">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TaskBackupRow}">
                                                        <TextBlock Text="{Binding TaskPath}" ToolTip="{Binding TaskPath}" Style="{StaticResource Text.Secondary}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="原因" Width="200" DisplayMemberBinding="{Binding Reason}"/>
                                            <GridViewColumn Header="状态" Width="150" DisplayMemberBinding="{Binding StateText}"/>
                                            <GridViewColumn Header="操作" Width="70">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TaskBackupRow}">
                                                        <Button Content="恢复" Style="{StaticResource Button.Link}"
                                                            Command="{Binding DataContext.RestoreTaskBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                        <!-- 白名单 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button Content="添加文件夹…" Command="{Binding AddWhitelistPathCommand}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="白名单" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock Text="白名单内的文件夹及其内容永远不会出现在扫描结果中。" Style="{StaticResource Text.Subtitle}" Margin="0,6,0,8"/>
                                <ItemsControl ItemsSource="{Binding WhitelistPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="{Binding}" ToolTip="{Binding}" Margin="0,0,70,0" VerticalAlignment="Center"/>
                                                <Button Content="移除" Style="{StaticResource Button.Link}" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.RemoveWhitelistPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="（尚未添加任何文件夹）" Style="{StaticResource Text.Secondary}"
                                    Visibility="{Binding WhitelistPaths.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>

                                <StackPanel Visibility="{Binding WhitelistItems.Count, Converter={StaticResource CountToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="已忽略的扫描项" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding WhitelistItems}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="{Binding}" ToolTip="{Binding}" Margin="0,0,70,0" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                                    <Button Content="恢复" Style="{StaticResource Button.Link}" HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.RemoveWhitelistItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="更新与记录" AutomationProperties.Name="更新与记录">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- 程序更新：常用操作优先展示 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="程序更新" FontWeight="SemiBold" FontSize="15"/>
                                <CheckBox IsChecked="{Binding CheckUpdatesOnStartup}" Margin="0,12,0,0"><TextBlock Text="启动时检查更新并静默下载，完成后询问是否安装" TextWrapping="Wrap"/></CheckBox>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{Binding AppVersionText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="检查 / 重试更新" Style="{StaticResource Button.Primary}" Command="{Binding CheckAppUpdateCommand}" Margin="8,0,0,0"/>
                                        <Button Content="取消程序更新" Command="{Binding Updates.CancelCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="安装已下载更新" Command="{Binding InstallAppUpdateCommand}" Margin="8,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding AppUpdateStatus}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                    Visibility="{Binding AppUpdateStatus, Converter={StaticResource NullToVis}}"/>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding Updates.DownloadPercent, Mode=OneWay}" Maximum="100" Height="6"
                                        Foreground="{StaticResource Brush.Accent}" Background="#E4EEEF" BorderThickness="0">
                                        <ProgressBar.Template>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <Grid x:Name="PART_Track" ClipToBounds="True">
                                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ProgressBar.Template>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding Updates.DownloadProgressText}" ToolTip="{Binding Updates.DownloadProgressText}"
                                        Style="{StaticResource Text.Secondary}" Height="18" TextWrapping="NoWrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="已完整下载的更新可在重启后恢复；清理等任务运行时会暂缓安装，请结束任务后点击安装。" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Expander Header="版本说明" Margin="0,6,0,0" Visibility="{Binding AvailableRelease, Converter={StaticResource NullToVis}}">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding AvailableRelease.Notes}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Expander Header="程序更新缓存">
                                <StackPanel DataContext="{Binding UpdateCache}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,10,0,8">
                                        <Button Content="预览可清理缓存" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
                                        <Button Content="将选中项移入隔离区" Command="{Binding CleanCommand}"/>
                                    </WrapPanel>
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,6">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,3,8,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Margin="10,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                        </Border>
                        <!-- 规则库 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="检查规则更新" Command="{Binding CheckDataUpdatesCommand}" Margin="0,0,8,0"/>
                                        <Button Content="查看规则更新目录" Command="{Binding OpenRulesDirCommand}"/>
                                        <Button Content="重新加载" Command="{Binding ReloadRulesCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="规则库" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock Text="{Binding RulesSummary}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding DataSetSummary}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <Expander Header="更新来源与校验说明" Margin="0,14,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="更新来源默认是官方仓库 boooooommmmmm/FatalCleaner（清空即恢复默认），也可填其他 GitHub 仓库（owner/repo，可加 @分支）或 https 根地址；GitHub 直连失败时会自动改用镜像再试一次。规则库、指纹库、弹窗规则与程序本身都从这里更新：清单与发布信息必须由受信任密钥签名、版本高于当前、每个文件哈希一致，否则不更换。" Style="{StaticResource Text.Secondary}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding UpdateSource, UpdateSourceTrigger=LostFocus}" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                                        AutomationProperties.Name="更新来源"/>
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="{Binding DataUpdateStatus}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                    Visibility="{Binding DataUpdateStatus, Converter={StaticResource NullToVis}}"/>
                                <ItemsControl ItemsSource="{Binding RejectedRules}" Margin="0,8,0,0"
                                    Visibility="{Binding RejectedRules.Count, Converter={StaticResource CountToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{StaticResource Brush.Danger}" TextWrapping="Wrap" Margin="0,2">
                                                <Run Text="{Binding RuleId, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding Reason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 历史 -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="导出日志 CSV…" Command="{Binding ExportLogCommand}"/>
                                        <Button Content="打开数据目录" Command="{Binding OpenDataDirCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="清理历史与操作日志" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DataDir}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,8"/>
                                <ListView ItemsSource="{Binding RecentBatches}" BorderThickness="0" MaxHeight="260">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding StartedText}"/>
                                            <GridViewColumn Header="模块" Width="200" DisplayMemberBinding="{Binding Modules}"/>
                                            <GridViewColumn Header="项目" Width="80" DisplayMemberBinding="{Binding ItemsText}"/>
                                            <GridViewColumn Header="处理量" Width="100" DisplayMemberBinding="{Binding FreedText}"/>
                                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding StateText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Text="（还没有清理记录）" Style="{StaticResource Text.Secondary}"
                                    Visibility="{Binding RecentBatches.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
