<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.SpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             xmlns:c="clr-namespace:CleanSweep.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SpaceAnalyzerViewModel}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="空间分析" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="查看磁盘空间被哪些目录占用。不跟随 Junction 与符号链接，不统计云端占位文件。" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 目标选择 -->
        <Grid Grid.Row="1" Margin="0,18,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding Drives}" DisplayMemberPath="Label" MinWidth="260" Height="34"
                      SelectionChanged="DriveChanged"/>
            <TextBox Grid.Column="1" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Height="34" Margin="8,0" VerticalContentAlignment="Center" Padding="6,0"/>
            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="开始分析" Style="{StaticResource Button.Primary}" Command="{Binding AnalyzeCommand}" MinWidth="110"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <Button Content="取消" Command="{Binding AnalyzeCancelCommand}" MinWidth="110"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- 面包屑 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Root, Converter={StaticResource NullToVis}}">
            <Button Content="↑ 上一级" Style="{StaticResource Button.Link}" Command="{Binding NavigateUpCommand}"/>
            <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="›" Margin="4,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                            <Button Content="{Binding Name}" Style="{StaticResource Button.Link}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- 主体 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 左：TreeMap + 目录列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="4">
                    <c:TreeMapControl x:Name="TreeMap" Node="{Binding Current}" NodeClicked="TreeMapNodeClicked"/>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <ListView ItemsSource="{Binding Rows}" BorderThickness="0" MouseDoubleClick="RowDoubleClick" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="目录" Width="320">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DirectoryRow}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text=" (无权限访问部分内容)" Style="{StaticResource Text.Secondary}"
                                                           Visibility="{Binding AccessDenied, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="占比" Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:DirectoryRow}">
                                            <Grid>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="14" Foreground="{StaticResource Brush.Accent}" BorderThickness="0"/>
                                                <TextBlock Text="{Binding PercentText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件数" Width="110" DisplayMemberBinding="{Binding FilesText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- 右：最大文件 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="最大的文件" FontWeight="SemiBold" Margin="12,10,12,6"/>
                    <ListView ItemsSource="{Binding LargestFiles}" BorderThickness="0" SelectionMode="Single" MouseDoubleClick="FileDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LargeFileRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Entry.Path}"/>
                                        <TextBlock Text="{Binding Directory}" Style="{StaticResource Text.Secondary}" ToolTip="{Binding Entry.Path}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}"/>
        </StackPanel>
    </Grid>
</UserControl>
