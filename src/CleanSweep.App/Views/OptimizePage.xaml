<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OptimizeViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid>
                <StackPanel>
                    <TextBlock Text="系统优化" Style="{StaticResource Text.Title}"/>
                    <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"
                               Text="服务、视觉效果、电源、休眠、网络、右键菜单。每一项都写明风险与恢复方式，逐项决定；本程序不提供“一键优化”。"/>
                </StackPanel>
                <Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="90"/>
            </Grid>

            <!-- 服务 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,12">
                <StackPanel>
                    <TextBlock Text="服务优化" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="“优化”只是把服务改为手动启动（需要时系统仍会拉起），绝不设为“已禁用”。修改前导出服务键备份，可在“设置 → 备份与还原”中还原。" Style="{StaticResource Text.Secondary}" Margin="0,6,0,4" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServiceTweakRow}">
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                                <Border Style="{StaticResource RiskBadge}" Background="{Binding Risk, Converter={StaticResource RiskBrush}}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Risk, Converter={StaticResource RiskText}}" Foreground="White" FontSize="11"/>
                                                </Border>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding RestoreHint}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="改为手动" Visibility="{Binding CanOptimize, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OptimizeServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="恢复自动" Style="{StaticResource Button.Link}" Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RestoreServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 视觉效果 / 电源 / 休眠 / 虚拟内存 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="外观与电源" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="视觉效果" FontWeight="SemiBold" Margin="0,12,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="让 Windows 选择" GroupName="VFX" IsChecked="{Binding VisualEffects, Converter={StaticResource IntEquals}, ConverterParameter=0}" Margin="0,0,16,0"/>
                        <RadioButton Content="最佳外观" GroupName="VFX" IsChecked="{Binding VisualEffects, Converter={StaticResource IntEquals}, ConverterParameter=1}" Margin="0,0,16,0"/>
                        <RadioButton Content="最佳性能（关闭动画与透明）" GroupName="VFX" IsChecked="{Binding VisualEffects, Converter={StaticResource IntEquals}, ConverterParameter=2}"/>
                    </StackPanel>

                    <TextBlock Text="电源计划" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding PowerPlans}" SelectedItem="{Binding SelectedPowerPlan}" DisplayMemberPath="Name" Width="260" Height="32" VerticalContentAlignment="Center"/>
                        <Button Content="应用" Command="{Binding ApplyPowerPlanCommand}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="休眠" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <Grid>
                        <TextBlock Text="{Binding HibernateText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,120,0"/>
                        <Button Content="{Binding HibernateButton}" Command="{Binding ToggleHibernateCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="虚拟内存" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <Grid>
                        <TextBlock Text="{Binding PageFileText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,140,0"/>
                        <Button Content="打开性能选项" Command="{Binding OpenPerformanceOptionsCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 网络 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="网络" FontWeight="SemiBold" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="刷新 DNS 缓存" Command="{Binding NetworkFixCommand}" CommandParameter="FlushDns"/>
                        <Button Content="重新获取 IP" Command="{Binding NetworkFixCommand}" CommandParameter="RenewDhcp" Margin="8,0,0,0"/>
                        <Button Content="重置 Winsock（需重启）" Command="{Binding NetworkFixCommand}" CommandParameter="ResetWinsock" Margin="8,0,0,0"/>
                        <Button Content="重置 TCP/IP（需重启）" Command="{Binding NetworkFixCommand}" CommandParameter="ResetTcpIp" Margin="8,0,0,0"/>
                        <Button Content="查看 TCP 全局参数" Style="{StaticResource Button.Link}" Command="{Binding ShowTcpCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox Text="{Binding NetworkOutput, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MaxHeight="200" Margin="0,8,0,0"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Visibility="{Binding NetworkOutput, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <!-- 右键菜单 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="右键菜单扩展" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="显示微软自带" IsChecked="{Binding ShowMicrosoftMenus}" VerticalAlignment="Center"/>
                            <Button Content="搜索索引选项…" Style="{StaticResource Button.Link}" Command="{Binding OpenIndexingOptionsCommand}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="取消勾选即禁用该扩展（通过系统的 Shell Extensions\Blocked 机制，不删除注册）。重新打开右键菜单生效，写入前自动备份。" Style="{StaticResource Text.Secondary}" Margin="0,6,0,4" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ContextMenus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ContextMenuRow}">
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Dll}"/>
                                                <TextBlock Text="{Binding Dll}" Style="{StaticResource Text.Secondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Scope}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Secondary}" MinWidth="140"/>
                                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource Brush.Risk.Confirm}" Margin="8,0,0,0" Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" BorderThickness="0" Background="Transparent" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
