<UserControl Style="{StaticResource Page}" x:Class="CleanSweep.App.Views.DuplicatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedFiles" Source="{Binding FileRows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="重复文件" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="按大小分组后比较内容哈希，硬链接与云端占位文件会被排除。每组至少保留一份，其余副本可移入隔离区。" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 范围与工具栏 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,12" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="查找范围" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Roots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Hover}" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" MaxWidth="360"/>
                                        <Button Content="✕" Style="{StaticResource Button.Link}" Padding="6,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="添加文件夹…" Command="{Binding AddRootCommand}"/>
                        <TextBlock Text="最小文件大小" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <TextBox Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="30" VerticalContentAlignment="Center" TextAlignment="Right" Padding="4,0"/>
                        <TextBlock Text="MB" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button Content="开始查找" Style="{StaticResource Button.Primary}" Command="{Binding FindCommand}" MinWidth="130"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <Button Content="取消" Command="{Binding FindCancelCommand}" MinWidth="130"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="移入隔离区" Style="{StaticResource Button.Danger}" Command="{Binding QuarantineSelectedCommand}" MinWidth="130" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,8" Visibility="{Binding Groups.Count, Converter={StaticResource CountToVis}}">
                        <WrapPanel>
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="每组保留最早的一份" Style="{StaticResource Button.Link}" Command="{Binding KeepOldestInAllGroupsCommand}" Margin="16,0,0,0"/>
                            <Button Content="清除选择" Style="{StaticResource Button.Link}" Command="{Binding ClearSelectionCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding SelectedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="12,0,12,8" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                               Text="单击选中一行；Ctrl 点击追加或取消；Shift 点击连续选择；Ctrl+A 全选；Esc 清除。选中行就是待移入隔离区的副本，每组至少保留一份。"/>
                    <ListBox x:Name="FilesList" ItemsSource="{Binding Source={StaticResource GroupedFiles}}" SelectionMode="Extended"
                             Margin="8,0,8,8" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" PreviewKeyDown="FilesList_PreviewKeyDown"
                             AutomationProperties.Name="重复文件列表">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="Margin" Value="4,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding Entry.Path}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" CornerRadius="4"
                                                    BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.Hover}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.AccentSoft}"/></Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,12,8,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name.Title}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name.SizeText}" Style="{StaticResource Text.Secondary}" Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DuplicateFileViewModel}">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                              Focusable="False" AutomationProperties.Name="{Binding Entry.Path}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Entry.Path}" VerticalAlignment="Center" ToolTip="{Binding Entry.Path}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0"/>
                                    <Button Grid.Column="3" Content="打开位置" Style="{StaticResource Button.Link}"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Groups.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Subtitle}" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="3" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" Visibility="{Binding Groups.Count, Converter={StaticResource CountToVis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
