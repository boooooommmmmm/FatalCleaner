<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CleanSweep.Service</RootNamespace>
    <AssemblyName>CleanSweep.Service</AssemblyName>
    <Version>0.23.1</Version>
    <Product>FatalCleaner</Product>
    <AssemblyTitle>FatalCleaner</AssemblyTitle>
    <Description>FatalCleaner · Windows 系统清理与优化</Description>
    <Company>FatalCleaner</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanSweep.Core\CleanSweep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\**\*.json" LinkBase="rules" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
